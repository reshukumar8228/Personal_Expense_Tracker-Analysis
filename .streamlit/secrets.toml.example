# Streamlit Cloud Secrets Configuration
# For deployment on Streamlit Community Cloud (share.streamlit.io):
# Go to App Settings -> Secrets and paste the following:

DATABASE_URL = "postgresql://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT_REF.supabase.co:5432/postgres"

[postgres]
url = "postgresql://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT_REF.supabase.co:5432/postgres"
